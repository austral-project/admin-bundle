 #}
{%- extends '@AustralAdmin/security/layout.html.twig' -%}
{%- trans_default_domain 'austral' -%}

{%- block security_content -%}
  <h2>{{ 'authentication.password_reset'|trans }}</h2>
  {%- if not valid -%}
    <p role="alert">{{ 'authentication.password_reset_invalid'|trans }}</p>
    <p><a href="{{ path('austral_admin_security_password_forgot') }}">{{ 'authentication.password_forgot'|trans }}</a></p>
  {%- else -%}
    {%- for error in errors -%}
      <div class="austral-admin-flash austral-admin-flash--error" role="alert">{{ error|trans }}</div>
    {%- endfor -%}
    <form method="post" action="{{ path('austral_admin_security_password_reset', {token: token}) }}">
      <p>
        <label for="password">{{ 'authentication.new_password'|trans }}</label>
        <input type="password" id="password" name="password" autocomplete="new-password" required>
      </p>
      <p>
        <label for="password_confirmation">{{ 'authentication.new_password_confirmation'|trans }}</label>
        <input type="password" id="password_confirmation" name="password_confirmation" autocomplete="new-password" required>
      </p>
      <input type="hidden" name="_token" value="{{ csrf_token(token_id) }}">
      <button type="submit">{{ 'authentication.password_reset_submit'|trans }}</button>
    </form>
  {%- endif -%}
{%- endblock -%}
