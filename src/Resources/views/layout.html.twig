 #
 # Layout of the admin. The styles and the scripts are the compiled build of design-bundle (entry
 # austral-design-admin): no inline style nor script, for a strict Content Security Policy. An application overrides
 # the templates in templates/bundles/AustralAdminBundle/.
 #}
{%- trans_default_domain 'austral' -%}
<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en') }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  {% if app.user -%}
  <meta name="austral-admin-csrf-token" content="{{ austral_admin_csrf_token() }}">
  {% endif -%}
  <title>{% block title %}{{ austral_admin.name }}{% endblock %}</title>
  {%- block stylesheets -%}
    {{ austral_design_styles('austral-design-admin') }}
  {%- endblock -%}
</head>
<body class="austral-admin austral-admin--{{ page|default('page') }}">
{%- block body -%}
  <header class="austral-admin-header">
    <a href="{{ path('austral_admin_index') }}">{{ austral_admin.name }}</a>
    {%- if app.user -%}
      <nav aria-label="{{ 'header.user'|trans }}">
        <a href="{{ path('austral_admin_my_account') }}">{{ app.user.userIdentifier }}</a>
        &nbsp;·&nbsp;
        <a href="{{ path('austral_admin_security_logout') }}">{{ 'links.logout'|trans }}</a>
      </nav>
    {%- endif -%}
  </header>
  <div class="austral-admin-container">
    <nav class="austral-admin-navigation" aria-label="{{ 'navigation.title'|trans }}">
      {%- block navigation -%}
        {%- import _self as macros -%}
        {{ macros.navigation(austral_admin_navigation()) }}
      {%- endblock -%}
    </nav>
    <main class="austral-admin-main" id="austral-admin-content">
      {%- block breadcrumb -%}
        {%- if breadcrumb|default([])|length > 1 -%}
          <nav class="austral-admin-breadcrumb" aria-label="{{ 'breadcrumb.title'|trans }}">
            <ol>
              {%- for item in breadcrumb -%}
                {%- set label = item.translate ? item.label|trans(item.parameters) : item.label -%}
                <li>{% if item.url %}<a href="{{ item.url }}">{{ label }}</a>{% else %}<span aria-current="page">{{ label }}</span>{% endif %}</li>
              {%- endfor -%}
            </ol>
          </nav>
        {%- endif -%}
      {%- endblock -%}
      {%- block flashes -%}
        {%- for type, messages in app.flashes -%}
          {%- for message in messages -%}
            <div class="austral-admin-flash austral-admin-flash--{{ type }}" role="{{ type == 'error' ? 'alert' : 'status' }}">{{ message|trans }}</div>
          {%- endfor -%}
        {%- endfor -%}
      {%- endblock -%}
      {%- block content -%}{%- endblock -%}
    </main>
  </div>
{%- endblock -%}
{%- block javascripts -%}
  {{ austral_design_scripts('austral-design-admin') }}
{%- endblock -%}
</body>
</html>

{%- macro navigation(items) -%}
  {%- import _self as macros -%}
  {%- if items -%}
    <ul>
      {%- for item in items -%}
        <li class="{{ item.active ? 'is-active' }}">
          <a href="{{ item.url }}"{% if item.active %} aria-current="page"{% endif %}>{{ item.label|trans({}, 'austral') }}</a>
          {%- if item.children -%}{{ macros.navigation(item.children) }}{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
{%- endmacro -%}
