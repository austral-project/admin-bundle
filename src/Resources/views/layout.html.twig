{#
 # This file is part of the Austral Admin Bundle package.
 #
 # (c) Austral <support@austral.dev>
 #
 # Layout of the admin. The styles and the scripts are the build of the project (entry austral-admin of
 # configureAustralAdmin(), see encore.mjs): no inline style nor script, for a strict Content Security Policy.
 # An application overrides the templates in templates/bundles/AustralAdminBundle/.
 #}
{%- trans_default_domain 'austral' -%}
<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en') }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <link type="image/x-icon" href="/bundles/australdesign/images/logo-app.png" rel="shortcut icon">
  <meta content="&copy; Austral" name="copyright">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black">
  <meta name="application-name" content="Austral">

  {% if app.user -%}
    <meta name="austral-admin-csrf-token" content="{{ austral_admin_csrf_token() }}">
  {% endif -%}

  <link rel="preconnect" href="https://fonts.gstatic.com">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600&display=swap" rel="stylesheet">
  <title>{% block title %}{{ austral_admin.name }}{% endblock %}</title>
  {%- block stylesheets -%}
    {{ austral_admin_styles() }}
  {%- endblock -%}
  {% include 'AustralAdmin/Layout/head.html.twig' ignore missing %}
  {% if app.user %}<style nonce="{{ austral_csp_nonce() }}">:root { --color-user: {{ app.user.avatarColor ?? "#6FA8DC" }}; }</style>{% endif %}
</head>
<body class="austral-admin austral-admin--{{ page|default('page') }}"
  data-uri="{{ app.request.uri }}"
  data-lazy-loading=""
  data-reload-trigger-enabled="{{ reloadTriggerOptions|json_encode }}"
  {% if mercure is defined -%}data-mercure="{{ mercure|json_encode }}"{% endif %}
>

  <div id="austral-body-container">
    <header id="austral-admin-header" class="aside-left">
    </header>
  </div>


{%- block body -%}
  <header class="austral-admin-header">
    <a href="{{ path('austral_admin_index') }}">{{ austral_admin.name }}</a>
    {%- if app.user -%}
      <nav aria-label="{{ 'header.user'|trans }}">
        <a href="{{ path('austral_admin_my_account') }}">{{ app.user.userIdentifier }}</a>
        &nbsp;·&nbsp;
        <a href="{{ path('austral_admin_security_logout') }}">{{ 'links.logout'|trans }}</a>
      </nav>
    {%- endif -%}
  </header>
  <div class="austral-admin-container">
    <nav class="austral-admin-navigation" aria-label="{{ 'navigation.title'|trans }}">
      {%- block navigation -%}
        {%- import _self as macros -%}
        {{ macros.navigation(austral_admin_navigation()) }}
      {%- endblock -%}
    </nav>
    <main class="austral-admin-main" id="austral-admin-content">
      {%- block breadcrumb -%}
        {%- if breadcrumb|default([])|length > 1 -%}
          <nav class="austral-admin-breadcrumb" aria-label="{{ 'breadcrumb.title'|trans }}">
            <ol>
              {%- for item in breadcrumb -%}
                {%- set label = item.translate ? item.label|trans(item.parameters) : item.label -%}
                <li>{% if item.url %}<a href="{{ item.url }}">{{ label }}</a>{% else %}<span aria-current="page">{{ label }}</span>{% endif %}</li>
              {%- endfor -%}
            </ol>
          </nav>
        {%- endif -%}
      {%- endblock -%}
      {%- block flashes -%}
        {%- for type, messages in app.flashes -%}
          {%- for message in messages -%}
            <div class="austral-admin-flash austral-admin-flash--{{ type }}" role="{{ type == 'error' ? 'alert' : 'status' }}">{{ message|trans }}</div>
          {%- endfor -%}
        {%- endfor -%}
      {%- endblock -%}
      {%- block content -%}{%- endblock -%}
    </main>
  </div>
{%- endblock -%}
{%- block javascripts -%}
  {{ austral_admin_scripts() }}
{%- endblock -%}
</body>
</html>

{%- macro navigation(items) -%}
  {%- import _self as macros -%}
  {%- if items -%}
    <ul>
      {%- for item in items -%}
        <li class="{{ item.active ? 'is-active' }}">
          <a href="{{ item.url }}"{% if item.active %} aria-current="page"{% endif %}>{{ item.label|trans({}, 'austral') }}</a>
          {%- if item.children -%}{{ macros.navigation(item.children) }}{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
{%- endmacro -%}
