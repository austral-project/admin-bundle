{%- extends '@AustralAdmin/layout.html.twig' -%}
{%- trans_default_domain 'austral' -%}

{%- block content -%}
  <h1>{{ 'breadcrumb.dashboard'|trans }}</h1>
  {%- for block in blocks -%}
    <section class="austral-admin-dashboard-block austral-admin-dashboard-block--{{ block.name }}">
      {{- include(block.template, block.vars) -}}
    </section>
  {%- endfor -%}
{%- endblock -%}
